[Unit]
Description=iTNet address-list update (meta) via Docker
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/itnet-addresslist-generator
ExecStart=/usr/bin/docker compose -f /opt/itnet-addresslist-generator/docker-compose.yml run --rm --remove-orphans update meta
User=root
