[Unit]
Description=iTNet address-list update (meta) via Docker
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/root/itnet-addresslist-generator/source
ExecStart=/usr/bin/docker compose -f /root/itnet-addresslist-generator/source/docker-compose.yml run --rm --remove-orphans update meta
User=root
